    "name": "парсинг JSON",
    "func": "// Ачивка 16 — subflow «Прочитать JSON из файла». Korol, ИИ-241\ntry {\n  msg.payload = JSON.parse(msg.payload);\n} catch (e) {\n  node.warn(\"Не удалось распарсить JSON: \" + e.message);\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
