  {
    "id": "lab2-f12-fn-read",
    "type": "function",
    "z": "lab2-tab-12",
    "name": "чтение контекста (Korol ИИ-241)",
    "func": "// Лаба 2, п.2.12 — читаю ранее сохранённые значения.\n// Проверка: нажать Deploy (перезапуск flow), затем кликнуть сюда —\n// счётчик НЕ обнуляется. Автор: Korol, группа ИИ-241\nconst counter = flow.get(\"msgCounter\");\nconst student = global.get(\"lastStudent\");\nconst lastRun = global.get(\"lastRun\");\n\nmsg.payload = {\n  student: \"Korol\",\n  group: \"ИИ-241\",\n  flowCounter: counter !== undefined ? counter : \"нет значения\",\n  globalStudent: student !== undefined ? student : \"нет значения\",\n  globalLastRun: lastRun !== undefined ? lastRun : \"нет значения\"\n};\nreturn msg;",
