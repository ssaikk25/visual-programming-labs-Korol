    "id": "lab2-f12-fn-count",
    "type": "function",
    "z": "lab2-tab-12",
    "name": "flow context: счётчик (Korol ИИ-241)",
    "func": "// Лаба 2, п.2.12 — счётчик в flow context.\n// Живёт между сообщениями и переживает Deploy.\n// Автор: Korol, группа ИИ-241\nlet counter = flow.get(\"msgCounter\") || 0;\ncounter = counter + 1;\nflow.set(\"msgCounter\", counter);\n\n// параллельно кладу значение в global context\nglobal.set(\"lastStudent\", \"Korol ИИ-241\");\nglobal.set(\"lastRun\", new Date().toISOString());\n\nmsg.payload = {\n  student: \"Korol\",\n  group: \"ИИ-241\",\n  msgCounter: counter,\n  scope: \"flow context (msgCounter) + global context (lastStudent)\"\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
